# Copy this file to .env and fill in real values. Never commit .env.

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Database ----
# Point at your existing local Postgres. First-time setup:
#   CREATE DATABASE verdant;
#   \c verdant
#   CREATE EXTENSION IF NOT EXISTS vector;
#
# Preferred: discrete vars (safe for passwords with @ : / and other characters).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_db_password
PGDATABASE=verdant
# Or, instead of the PG* vars above, a single URL (URL-encode special chars):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/verdant

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Secrets ----
# 32-byte key for AES-256-GCM. Generate one with:  openssl rand -base64 32
MASTER_ENCRYPTION_KEY=replace_with_a_32_byte_base64_key
# Session/auth signing secret. Generate with:  openssl rand -hex 32
AUTH_SECRET=replace_with_a_long_random_string

# ---- Model gateway and local models ----
LITELLM_BASE_URL=http://localhost:4001
OLLAMA_BASE_URL=http://localhost:11434

# ---- API ----
API_PORT=4000
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
